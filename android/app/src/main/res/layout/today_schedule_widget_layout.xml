<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/widget_today_day_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TODAY'S SCHEDULE"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <TextView
            android:id="@+id/widget_today_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="3 Classes"
            android:textColor="#60A5FA"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Class Item 1 -->
    <LinearLayout
        android:id="@+id/widget_item_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/widget_inner_card"
        android:padding="8dp"
        android:layout_marginBottom="5dp"
        android:gravity="center_vertical">

        <View
            android:layout_width="3dp"
            android:layout_height="24dp"
            android:background="#2563EB"
            android:layout_marginEnd="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_item_1_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CS 112 - Data Structures"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_item_1_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Room 304"
                android:textColor="#94A3B8"
                android:textSize="10.5sp"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_item_1_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8:00 - 9:30 AM"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Class Item 2 -->
    <LinearLayout
        android:id="@+id/widget_item_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/widget_inner_card"
        android:padding="8dp"
        android:layout_marginBottom="5dp"
        android:gravity="center_vertical">

        <View
            android:layout_width="3dp"
            android:layout_height="24dp"
            android:background="#10B981"
            android:layout_marginEnd="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_item_2_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IT 211 - Web Development"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_item_2_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lab 2"
                android:textColor="#94A3B8"
                android:textSize="10.5sp"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_item_2_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10:00 - 11:30 AM"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Class Item 3 -->
    <LinearLayout
        android:id="@+id/widget_item_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/widget_inner_card"
        android:padding="8dp"
        android:gravity="center_vertical">

        <View
            android:layout_width="3dp"
            android:layout_height="24dp"
            android:background="#8B5CF6"
            android:layout_marginEnd="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_item_3_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GE 4 - Purposive Comm"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_item_3_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Room 102"
                android:textColor="#94A3B8"
                android:textSize="10.5sp"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_item_3_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1:00 - 2:30 PM"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Empty State Text (Visible when 0 classes) -->
    <TextView
        android:id="@+id/widget_today_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No classes scheduled for today 🎉"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone" />
</LinearLayout>
