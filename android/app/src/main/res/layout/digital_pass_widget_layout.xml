<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_pass_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- University Top Band -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/widget_pass_school"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NEMSU · STUDENT PASS"
            android:textColor="#F59E0B"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <TextView
            android:id="@+id/widget_pass_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A.Y. 2026-2027"
            android:textColor="#94A3B8"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Student Details Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/widget_inner_card"
        android:padding="10dp"
        android:gravity="center_vertical">

        <!-- Avatar / Photo Placeholder -->
        <ImageView
            android:id="@+id/widget_pass_avatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_launcher_background"
            android:background="#2563EB"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_pass_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ethan Rivera"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_pass_program"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BS Computer Science"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_pass_id_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID: 2022-10492"
                android:textColor="#94A3B8"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Barcode Strip Simulation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/widget_pass_barcode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="|| | ||| | || |||| | ||| || |||| | || |"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />
    </LinearLayout>
</LinearLayout>
