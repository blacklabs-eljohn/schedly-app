<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_pass_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_digital_id_bg"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <!-- Top Row: School Shield & University Name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️ "
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_pass_school"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NEMSU"
            android:textColor="#FFFFFF"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Middle Row: Photo Container + Student Details & Meta Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Student Photo Frame (76dp x 76dp) -->
        <ImageView
            android:id="@+id/widget_pass_avatar"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/widget_id_photo_frame"
            android:scaleType="centerCrop"
            android:padding="2dp"
            android:layout_marginEnd="16dp" />

        <!-- Info Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Name (Pure White Bold) -->
            <TextView
                android:id="@+id/widget_pass_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vanessa Cacabelos"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- Program (High-Legibility Soft White) -->
            <TextView
                android:id="@+id/widget_pass_program"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BS TOURISM MANAGEMENT"
                android:textColor="#F1F5F9"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />

            <!-- Meta Grid (YEAR, SECTION, A.Y.) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <!-- Year -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YEAR"
                        android:textColor="#E2E8F0"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/widget_pass_year_level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3RD YEAR"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Section -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SECTION"
                        android:textColor="#E2E8F0"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/widget_pass_section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TM-3B"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Academic Year -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="A.Y."
                        android:textColor="#E2E8F0"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/widget_pass_academic_year"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2026–2027"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Translucent White Hairline Divider -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp" />

    <!-- Bottom Row: ID Number & Barcode -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- ID Number & Hint -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_pass_id_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-10492"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap for pass details"
                android:textColor="#E2E8F0"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Simulated Crisp Barcode -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="|||| ||| |||| | ||||| || ||| |||| | |||"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
    </LinearLayout>
</LinearLayout>
