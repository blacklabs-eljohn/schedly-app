<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#581C87"
                android:centerColor="#2E1065"
                android:endColor="#13072B"
                android:angle="135" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#26FFFFFF"
                android:centerColor="#0AFFFFFF"
                android:endColor="#00000000"
                android:angle="315" />
            <corners android:radius="24dp" />
            <stroke android:width="1.2dp" android:color="#33C084FC" />
        </shape>
    </item>
</layer-list>
